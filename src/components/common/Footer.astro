---
const brands = [
  { name: 'Apple iPhone & Watch', href: '/apple' },
  { name: 'Samsung Galaxy', href: '/samsung' },
  { name: 'Xiaomi & Redmi', href: '/xiaomi' },
  { name: 'Google Pixel', href: '/google' },
  { name: 'OnePlus', href: '/oneplus' },
];

const legal = [
  { name: 'Privacy Policy', href: '/privacy-policy' },
  { name: 'Terms of Use', href: '/terms' },
  { name: 'Contact & Support', href: '/contact' },
];
---

<footer class="border-t border-slate-850 bg-slate-950/60 mt-20 text-xs text-slate-400">
  <div class="max-w-5xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="space-y-3">
      <div class="flex items-center gap-2 font-bold text-white text-base">
        <span class="text-sky-400">🌊</span> ClearWave
      </div>
      <p class="text-slate-400 leading-relaxed text-[13px]">
        Acoustic resonance frequency engine designed to dislodge trapped water droplets and fine dust particles from phone speaker grilles.
      </p>
    </div>

    <div>
      <h4 class="font-semibold text-white uppercase tracking-wider text-[11px] mb-3">Supported Catalogs</h4>
      <ul class="space-y-2">
        {brands.map((b) => (
          <li>
            <a href={b.href} class="hover:text-sky-400 transition">
              {b.name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="font-semibold text-white uppercase tracking-wider text-[11px] mb-3">Legal & Safety</h4>
      <ul class="space-y-2 mb-4">
        {legal.map((l) => (
          <li>
            <a href={l.href} class="hover:text-sky-400 transition">
              {l.name}
            </a>
          </li>
        ))}
      </ul>
      <p class="text-[11px] text-slate-400 leading-normal">
        Disclaimer: Keep the volume at a safe distance from ears during operation. ClearWave is not liable for existing hardware liquid ingress damage.
      </p>
    </div>
  </div>

  <div class="border-t border-slate-900 py-6 text-center text-slate-400 text-[12px]">
    © {new Date().getFullYear()} ClearWave. All rights reserved. Cloudflare Edge Optimized.
  </div>
</footer>