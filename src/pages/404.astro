---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  seo={{
    title: 'Page Not Found (404)',
    description: 'The speaker cleaning profile you are looking for does not exist or has moved.',
    canonical: '/404'
  }}
>
  <div class="py-20 text-center flex flex-col items-center justify-center">
    <span class="text-6xl mb-4">🌊</span>
    <h1 class="text-4xl font-extrabold text-white tracking-tight mb-2">404 - Device Not Found</h1>
    <p class="text-sm text-slate-400 max-w-md mx-auto mb-8">
      We couldn't find the specific model or page you requested. Try running the universal speaker ejector tool instead.
    </p>
    <a
      href="/"
      class="px-6 py-3 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-sm transition shadow-lg shadow-sky-500/20"
    >
      Go to Universal Cleaner
    </a>
  </div>
</BaseLayout>