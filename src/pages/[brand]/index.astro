---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const devices = await getCollection('devices');
  return devices.map((entry) => ({
    params: { brand: entry.data.brandSlug },
    props: { brandData: entry.data },
  }));
}

const { brandData } = Astro.props;

const breadcrumbs = [
  { name: brandData.brand, url: `/${brandData.brandSlug}` }
];
---

<BaseLayout
  seo={{
    title: `Fix & Eject Water from ${brandData.brand} Speakers`,
    description: `Select your ${brandData.brand} smartphone or smartwatch model to run an acoustically tuned water and dust ejection tone.`,
    canonical: `/${brandData.brandSlug}`
  }}
>
  <div class="max-w-4xl mx-auto py-4">
    <Breadcrumb items={breadcrumbs} />

    <header class="text-center my-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        {brandData.brand} Speaker Cleaner Hub
      </h1>
      <p class="mt-2 text-sm text-slate-400 max-w-xl mx-auto">
        Choose your specific {brandData.brand} model to get the exact acoustic frequency profile required to clear clogged speaker grilles.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8">
      {brandData.models.map((model) => (
        <a
          href={`/${brandData.brandSlug}/${model.slug}`}
          class="p-5 bg-slate-900/50 border border-slate-800 rounded-2xl hover:border-sky-500/50 hover:bg-slate-900/80 transition flex flex-col justify-between group"
        >
          <div>
            <div class="flex items-center justify-between">
              <h2 class="text-base font-semibold text-slate-200 group-hover:text-sky-400 transition">
                {model.name}
              </h2>
              <span class="text-xs font-mono text-sky-400 bg-sky-950/70 border border-sky-800/40 px-2 py-0.5 rounded">
                {model.recommendedFrequency} Hz
              </span>
            </div>
            <p class="text-xs text-slate-400 mt-2 line-clamp-2">
              {model.speakerSetup}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-800/60 flex items-center justify-between text-[11px] text-slate-500">
            <span>Rating: {model.ipRating}</span>
            <span class="text-sky-400 group-hover:translate-x-1 transition">Clean Now →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>